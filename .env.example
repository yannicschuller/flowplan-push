# Copy to .env (never commit .env). See README → Configuration reference.
# Public https URL of this relay (the official Flowplan relay is https://push.flowplan.org).
RELAY_PUBLIC_URL=https://push.example.com
# openssl rand -base64 32
RELAY_STORAGE_KEY=
RELAY_STORAGE_KEYS_OLD=
# APNs: key id (10 characters), your Apple Team ID (developer.apple.com → Account →
# Membership details, 10 characters, e.g. ABCDE12345) and the .p8 key
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of AuthKey_XXXXXXXXXX.p8 (multi-line, "\n"-escaped or base64)
APNS_KEY=
# Contents of the Firebase service-account JSON (or base64 of it)
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=
ALLOWED_BUNDLE_IDS=app.flowplan.mobile
# Number of reverse proxies in front of the relay (one Traefik/Caddy/nginx = 1)
TRUST_PROXY=1
# openssl rand -hex 32
METRICS_TOKEN=
LOG_LEVEL=info

# Optional admin dashboard at /admin, behind OpenID Connect (README "Admin dashboard (OIDC)").
# Disabled while ADMIN_OIDC_ISSUER is empty.
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
# Default: openid email profile
ADMIN_OIDC_SCOPES=
# At least one of these three:
ADMIN_EMAILS=
ADMIN_SUBJECTS=
ADMIN_GROUPS=
# Default: groups (dots for nested claims, e.g. realm_access.roles)
ADMIN_GROUPS_CLAIM=
# Recommended: comma-separated IPs/CIDRs that may reach /admin at all
ADMIN_ALLOWED_IPS=
